# Safe defaults. Copy to .env; never commit the result.
IPEG_MODE=shadow
IPEG_LIVE_ENABLED=false
IPEG_CONFIG_PATH=/app/config/defaults.yaml
IPEG_STATE_PATH=/app/state/ipeg.sqlite3
IPEG_PARQUET_DIR=/app/data/market
IPEG_LOG_LEVEL=INFO

# Optional Telegram shadow/control UI
IPEG_TELEGRAM_ENABLED=false
IPEG_TELEGRAM_BOT_TOKEN=
IPEG_TELEGRAM_OWNER_CHAT_ID=

# Exchange credentials are intentionally omitted until Live Canary Ready.
# They must be injected on the VPS and must never have withdrawal permission.
