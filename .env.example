# Safe defaults. Copy to .env; never commit the result.
IPEG_MODE=shadow
IPEG_LIVE_ENABLED=false
IPEG_CONFIG_PATH=/app/config/defaults.yaml
IPEG_STATE_PATH=/app/state/ipeg.sqlite3
IPEG_PARQUET_DIR=/app/data/market
IPEG_LOG_LEVEL=INFO
IPEG_MAX_CLOCK_SKEW_MS=1000

# Optional Telegram shadow/control UI
IPEG_TELEGRAM_ENABLED=false
IPEG_TELEGRAM_BOT_TOKEN=
IPEG_TELEGRAM_OWNER_CHAT_ID=

# Release binding. Keep blank during ordinary shadow operation.
IPEG_RELEASE_SHA=
IPEG_CONTAINER_IMAGE_DIGEST=

# Independent live gates. Keep blank and live disabled until C4 is independently approved.
IPEG_LOCAL_UNLOCK_SECRET=
IPEG_EMERGENCY_UNLOCK_SECRET=
# IPEG_EMERGENCY_UNLOCK is invocation-only; never persist it in this file.

# Restricted trading/read-only account credentials. Never grant withdrawal or transfer.
IPEG_BINANCEUSDM_API_KEY=
IPEG_BINANCEUSDM_API_SECRET=
IPEG_BINANCEUSDM_API_PASSWORD=
IPEG_BYBIT_API_KEY=
IPEG_BYBIT_API_SECRET=
IPEG_BYBIT_API_PASSWORD=
IPEG_OKX_API_KEY=
IPEG_OKX_API_SECRET=
IPEG_OKX_API_PASSWORD=
